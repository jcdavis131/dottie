# jarvisd deploy config -- copy to deploy/.env, fill in, chmod 600. deploy/.env is
# gitignored (root .gitignore `.env`); never commit it. Every var is from
# docs/JARVISD_SPEC.md §7 unless marked (compose) or (tunnel).
#
# Two readers use this file:
#   1. `docker compose --env-file deploy/.env ...`  -> ${VAR} substitution in the compose file
#   2. `env_file: deploy/.env` in the jarvisd service -> the container's environment
# Keep comments on their own lines; trailing `# ...` after a value is not portable.
# Everything in this file is visible inside the jarvisd container (env_file), including
# CLOUDFLARE_TUNNEL_TOKEN. The daemon runs unprivileged and does not read the token, but
# a harness subprocess could; if that bothers you, keep the token in a second file and run
# compose with `--env-file deploy/.env --env-file deploy/.env.tunnel`.

# ---- required ----------------------------------------------------------------------------
# Static bearer for /mcp, /sse and /api/* (spec §2). jarvisd refuses to start on a
# non-loopback bind without it. Generate one:
#   python -c "import secrets; print('jv_' + secrets.token_urlsafe(32))"
JARVIS_BEARER=

# ---- public hostname ---------------------------------------------------------------------
# Hostname clients will use. Feeds the DNS-rebinding allowlist when the daemon is reachable
# from the internet (spec §7). Tunnel: jarvis.<zone>. Hugging Face: <owner>-<space>.hf.space
# Leave empty until you know it: an empty value means no allowlist, a WRONG value rejects
# every request that arrives with the real hostname.
JARVIS_PUBLIC_HOST=

# ---- optional brain (spec §6) ------------------------------------------------------------
# The default is $0: JARVIS_BRAIN=auto uses Ollama on the home box (OLLAMA_HOST below)
# when no ANTHROPIC_API_KEY is set. Set a key only if you want the paid Anthropic path; a
# set key makes auto pick Anthropic. `ollama` / `anthropic` force one; `off` disables
# jarvis.ask. With neither reachable, jarvis.ask returns {ok:false, error:"brain unavailable"}.
#JARVIS_BRAIN=auto
# Ollama model (JARVIS_MODEL, if set, wins over this). 120 s per /api/chat call.
#OLLAMA_MODEL=qwen3:32b
#JARVIS_BRAIN_TIMEOUT=120
# Anthropic (paid). Needs `pip install 'jarvisd[brain]'` in the image.
#ANTHROPIC_API_KEY=
#JARVIS_MODEL=claude-opus-5
#JARVIS_EFFORT=high
# Per-minute rate limits (spec §2 defaults: 1000 per IP, 60 per key, 20 per X-Agent-Id).
#JARVIS_RATE_IP=1000
#JARVIS_RATE_KEY=60
#JARVIS_RATE_AGENT=20

# ---- harness / scout ---------------------------------------------------------------------
# URL allowlist for downstream MCP (scout default when unset).
#BIGBANG_POLICY_FILE=/workspace/.scout/policy.yaml
# Ollama on the home box, as seen from inside the container (compose adds the
# host.docker.internal alias and already defaults OLLAMA_HOST to this value; scout's
# plugins and the `ollama` brain provider both read it). Change only if Ollama listens
# elsewhere.
#OLLAMA_HOST=http://host.docker.internal:11434

# ---- compose-only ------------------------------------------------------------------------
# Host directory mounted at /workspace (JARVIS_WORKSPACE inside the container).
# Windows: JARVIS_WORKSPACE_HOST=C:/Users/<you>/workspace
JARVIS_WORKSPACE_HOST=~/workspace

# ---- tunnel profile ----------------------------------------------------------------------
# Token from Zero Trust -> Networks -> Tunnels -> <tunnel> -> Install connector.
# Only read when you run `--profile tunnel`.
#CLOUDFLARE_TUNNEL_TOKEN=

# ---- fixed by docker-compose.jarvisd.yml; do NOT set here --------------------------------
# JARVIS_DB=/data/jarvis.db   JARVIS_HOST=0.0.0.0   JARVIS_PORT=8790   JARVIS_WORKSPACE=/workspace
